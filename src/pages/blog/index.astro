---
import { blogPath } from "../../lib/site.ts"

export const prerender = true

// The blog listing is language addressed; keep the old URL alive with the same
// HTML redirect pattern used by `/posts/[slug]`.
const targetUrl = blogPath("en")
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="robots" content="noindex, nofollow">
		<meta http-equiv="refresh" content={`0; url=${targetUrl}`}>
		<link rel="canonical" href={targetUrl}>
		<title>Redirecting…</title>
	</head>
	<body>
		<p>The blog has moved to <a href={targetUrl}>{targetUrl}</a>.</p>
		<script is:inline define:vars={{ targetUrl }}>
		window.location.replace(targetUrl)
		</script>
	</body>
</html>
