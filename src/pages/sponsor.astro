---
import BaseLayout from "../layouts/BaseLayout.astro"
import site from "../lib/site.ts"

const cryptoAddresses = {
	BTC: "3LdNwreu7xAoK5hjGRiPae8fE3mtRcbBg4",
	ETH: "0x08c799ed97218bb9eF09c14a6CED89a02bc8D6Ae",
	SOL: "HWTCff3cpc7MguF5DMEybFt1NF9Vu15oteYXWMeNBe8v",
	SUI: "0xcbb0bb734638770cac5b28d69caa6899bcf54cc6eba37347746b4b6f33e4dffe"
} as const
---

<BaseLayout
	title="Support My Work | Aster"
	description="Support Aster's work through GitHub Sponsors, Substack, or cryptocurrency donations."
	ogTitle="Support My Work | Aster"
	ogDescription="Support Aster's work through GitHub Sponsors, Substack, or cryptocurrency donations."
	ogUrl={`${site.baseUrl}/sponsor`}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Home", item: site.baseUrl },
				{
					"@type": "ListItem",
					position: 2,
					name: "Support",
					item: `${site.baseUrl}/sponsor`
				}
			]
		}
	]}
>
	<div class="flex flex-col gap-12">
		<header class="flex flex-col gap-3 border-b border-base-300 pb-8">
			<p class="eyebrow">Support</p>
			<h1 class="text-3xl font-bold tracking-tight md:text-4xl">
				Support my work
			</h1>
			<p class="max-w-[70ch] text-base-content/70">
				Everything I publish is free and open source. If it has been useful to
				you, here are a few ways you can support it.
			</p>
		</header>

		<section class="flex flex-col gap-4">
			<h2 class="text-xl font-semibold tracking-tight">GitHub Sponsors</h2>
			<div class="flex justify-center">
				<iframe
					src="https://github.com/sponsors/4ster-light/card"
					title="Sponsor 4ster-light"
					width="600"
					height="150"
					class="w-full max-w-150 rounded-lg border border-primary/30"
				></iframe>
			</div>
		</section>

		<section class="flex flex-col gap-4">
			<h2 class="text-xl font-semibold tracking-tight">
				Subscribe on Substack
			</h2>
			<div class="flex justify-center overflow-x-auto">
				<iframe
					src="https://4sterlight.substack.com/embed"
					height="320"
					title="Subscribe to my Substack publication"
					class="w-full border border-primary/30 rounded-lg"
				></iframe>
			</div>
		</section>

		<section class="flex flex-col gap-4">
			<h2 class="text-xl font-semibold tracking-tight">
				Cryptocurrency donations
			</h2>
			<p class="max-w-[70ch] text-base-content/70">
				You can also send cryptocurrency to any of the following wallet
				addresses if preferred.
			</p>
			<ul class="flex flex-col gap-3">
				{Object.entries(cryptoAddresses).map(([coin, address]) => (
					<li class="flex items-center gap-3 font-mono text-sm">
						<strong class="w-10 text-base-content/70">{coin}</strong>
						<code
							class="flex-1 truncate rounded-md border border-base-300 bg-base-200/60 px-2 py-1 text-xs"
							title={address}
						>
							{address}
						</code>
						<button
							type="button"
							class="btn btn-sm btn-outline"
							data-copy-address={address}
						>
							Copy
						</button>
					</li>
				))}
			</ul>
		</section>
	</div>

	<script>
	document
		.querySelectorAll<HTMLButtonElement>("[data-copy-address]")
		.forEach((button) => {
			button.addEventListener("click", () => {
				const target = button.getAttribute("data-copy-address") || ""
				navigator.clipboard.writeText(target).then(() => {
					const previous = button.textContent
					button.textContent = "Copied"
					setTimeout(() => {
						button.textContent = previous
					}, 1200)
				})
			})
		})
	</script>
</BaseLayout>
