---
import { getCollection } from "astro:content"
import ButtonLink from "../../../components/ButtonLink.astro"
import EngagementConsent from "../../../components/EngagementConsent.astro"
import PostInteractions from "../../../components/PostInteractions.astro"
import PostMeta from "../../../components/PostMeta.astro"
import TocSidebar from "../../../components/TocSidebar.astro"
import leftArrowsIcon from "../../../icons/LeftArrows.svg?url"
import loveIcon from "../../../icons/Love.svg?url"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import marked, { preloadHighlightLanguages } from "../../../lib/marked.ts"
import site from "../../../lib/site.ts"
import { extractHeadings } from "../../../lib/toc.ts"

export const prerender = true

export const getStaticPaths = async () => {
	const posts = await getCollection("posts")
	return posts.map((post) => ({
		params: { lang: post.data.lang || "en", slug: post.id }
	}))
}

const lang = (Astro.params.lang || "en") as "en" | "es"
const slug = Astro.params.slug || ""
const allPosts = (await getCollection("posts")).sort(
	(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
)
const post = allPosts.find(
	(entry) => entry.id === slug && (entry.data.lang || "en") === lang
)

if (!post) {
	return Astro.redirect("/")
}

const translatedPost = post.data.translationKey
	? allPosts.find(
			(entry) =>
				entry.id !== post.id &&
				entry.data.translationKey === post.data.translationKey &&
				(entry.data.lang || "en") !== lang
		)
	: undefined

await preloadHighlightLanguages(post.body || "")
const parsed = extractHeadings(marked.parse(post.body || "") as string)
const recentPosts = allPosts
	.filter(
		(entry) =>
			entry.id !== post.id &&
			(entry.data.lang || "en") === lang &&
			!entry.data["is-preview"]
	)
	.slice(0, 5)
	.map((entry) => ({
		slug: entry.id,
		title: entry.data.title,
		date: entry.data.date,
		lang: entry.data.lang || "en"
	}))

const switchLabel = lang === "es" ? "Read in English 🇬🇧" : "Leer en español 🇪🇸"
const switchHref = translatedPost
	? `/${translatedPost.data.lang || "en"}/posts/${translatedPost.id}`
	: undefined
const canonicalUrl = `${site.baseUrl}/${lang}/posts/${post.id}`
const alternateUrls = [
	{ lang, href: canonicalUrl },
	...(translatedPost
		? [
				{
					lang: translatedPost.data.lang || "en",
					href: `${site.baseUrl}/${translatedPost.data.lang || "en"}/posts/${translatedPost.id}`
				}
			]
		: [])
]

const langPosts = allPosts.filter(
	(entry) => (entry.data.lang || "en") === lang && !entry.data["is-preview"]
)
const currentIndex = langPosts.findIndex((entry) => entry.id === post.id)
const newerPost = currentIndex > 0 ? langPosts[currentIndex - 1] : undefined
const olderPost =
	currentIndex >= 0 && currentIndex < langPosts.length - 1
		? langPosts[currentIndex + 1]
		: undefined
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	ogTitle={post.data.title}
	ogDescription={post.data.description}
	ogType="article"
	{lang}
	ogLocale={lang === "es" ? "es_ES" : "en_US"}
	ogUrl={canonicalUrl}
	{canonicalUrl}
	{alternateUrls}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "Article",
			headline: post.data.title,
			description: post.data.description,
			datePublished: post.data.date.toISOString(),
			dateModified: post.data.date.toISOString(),
			author: { "@type": "Person", name: "David Vivar Bogónez" },
			publisher: {
				"@type": "Organization",
				name: "✰λster✰",
				url: site.baseUrl,
				logo: { "@type": "ImageObject", url: `${site.baseUrl}/pfp.jpg` }
			},
			license: "https://creativecommons.org/licenses/by-nc-sa/4.0/",
			mainEntityOfPage: canonicalUrl,
			image: `${site.baseUrl}/og.png`
		}
	]}
>
	<PostMeta post={{ slug: post.id, ...post.data, body: post.body }} header />

	{switchHref && (
		<div class="mt-6">
			<ButtonLink href={switchHref} target="_self">
				{switchLabel}
			</ButtonLink>
		</div>
	)}

	<div class="divider my-10"></div>

	<div class="grid grid-cols-1 lg:grid-cols-6 gap-8">
		<main class="-mt-6 prose lg:col-span-4" set:html={parsed.html} />

		<div
			class="lg:col-span-2 lg:border-l lg:border-base-300 lg:pl-8 hidden lg:block"
		>
			<TocSidebar
				items={parsed.items.map((item) => ({
					depth: item.level,
					slug: item.id,
					text: item.text
				}))}
				{recentPosts}
				{lang}
			/>
		</div>
	</div>

	<PostInteractions slug={post.id} {lang} />
	<EngagementConsent {lang} />

	{(olderPost || newerPost) && (
		<nav
			class="mt-12 grid gap-4 border-t border-base-300 pt-8 sm:grid-cols-2"
			aria-label="More posts"
		>
			{olderPost ? (
				<a
					href={`/${lang}/posts/${olderPost.id}`}
					class="group flex flex-col gap-1 rounded-xl border border-base-300 p-4 transition-colors hover:border-primary/40 hover:bg-base-200/40"
				>
					<span class="font-mono text-xs uppercase tracking-widest text-base-content/50">
						← Older
					</span>
					<span class="font-semibold transition-colors group-hover:text-primary">
						{olderPost.data.title}
					</span>
				</a>
			) : (
				<span />
			)}
			{newerPost ? (
				<a
					href={`/${lang}/posts/${newerPost.id}`}
					class="group flex flex-col items-end gap-1 rounded-xl border border-base-300 p-4 text-right transition-colors hover:border-primary/40 hover:bg-base-200/40 sm:col-start-2"
				>
					<span class="font-mono text-xs uppercase tracking-widest text-base-content/50">
						Newer →
					</span>
					<span class="font-semibold transition-colors group-hover:text-primary">
						{newerPost.data.title}
					</span>
				</a>
			) : (
				<span />
			)}
		</nav>
	)}

	<div class="divider"></div>

	<div class="mt-8 border-l-2 border-primary pl-4 text-sm text-base-content/70">
		{lang === "es" ? (
			<>
				Texto y contenido de este artículo licenciados bajo{" "}
				<a
					href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.es"
					class="link link-hover link-primary"
					rel="license"
				>
					CC BY-NC-SA 4.0
				</a>
				.
			</>
		) : (
			<>
				Text and content of this article licensed under{" "}
				<a
					href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
					class="link link-hover link-primary"
					rel="license"
				>
					CC BY-NC-SA 4.0
				</a>
				.
			</>
		)}
	</div>

	<footer class="mt-10 flex flex-wrap items-center justify-between gap-4">
		<ButtonLink href={site.blog} target="" ariaLabel="Back to all posts">
			<img
				src={leftArrowsIcon}
				alt=""
				width="32"
				height="32"
				decoding="async"
				class="size-8"
			>
			All posts
		</ButtonLink>
		<ButtonLink href={site.donate} ariaLabel="Sponsor me">
			<img
				src={loveIcon}
				alt=""
				width="24"
				height="24"
				decoding="async"
				class="size-6"
			>
			Sponsor
		</ButtonLink>
	</footer>
</BaseLayout>

<script>
const enhanceCodeBlocks = () => {
	const blocks = document.querySelectorAll<HTMLElement>(".shiki-wrapper")
	for (const wrapper of blocks) {
		if (wrapper.querySelector(".code-copy")) continue

		const button = document.createElement("button")
		button.type = "button"
		button.className = "code-copy"
		button.textContent = "Copy"
		button.setAttribute("aria-label", "Copy code to clipboard")

		button.addEventListener("click", async () => {
			const lines = Array.from(
				wrapper.querySelectorAll<HTMLElement>("code .line")
			)
			const text = lines
				.map((line) => {
					const clone = line.cloneNode(true) as HTMLElement
					clone.querySelector(".line-number")?.remove()
					return clone.textContent ?? ""
				})
				.join("\n")

			try {
				await navigator.clipboard.writeText(text)
				button.textContent = "Copied"
			} catch (_error) {
				button.textContent = "Error"
			}
			window.setTimeout(() => {
				button.textContent = "Copy"
			}, 1500)
		})

		wrapper.appendChild(button)
	}
}

document.addEventListener("astro:page-load", enhanceCodeBlocks)
enhanceCodeBlocks()
</script>
