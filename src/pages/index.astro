---
import { getCollection } from "astro:content"
import LanguageFilter from "../components/LanguageFilter.astro"
import PostMeta from "../components/PostMeta.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
import { FEATURED_REPOS } from "../lib/projects.ts"
import site from "../lib/site.ts"

const posts = (await getCollection("posts"))
	.filter((post) => !post.data["is-preview"])
	.sort(
		(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
	)

const enPosts = posts.filter((post) => (post.data.lang || "en") === "en")
const esPosts = posts.filter((post) => post.data.lang === "es")
const initialPosts = enPosts.length > 0 ? "en" : "es"
const recentLimit = 4

const toCard = (post: (typeof posts)[number]) => ({
	slug: post.id,
	...post.data,
	body: post.body
})

const featured = FEATURED_REPOS.slice(0, 6)
---

<BaseLayout
	title="✰λster✰ | Programming, Computer Science, and Open Source"
	description="David Vivar Bogónez's blog about programming, computer science, and open source projects."
	ogTitle="David Vivar Bogónez | Software Developer & Programming Blog"
	ogDescription="David Vivar Bogónez's blog about programming, computer science, and open source projects."
	ogUrl={site.baseUrl}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: "✰λster✰",
			url: site.baseUrl,
			description:
				"David Vivar Bogónez's blog about programming, computer science, and open source projects."
		},
		{
			"@context": "https://schema.org",
			"@type": "Organization",
			name: "✰λster✰",
			url: site.baseUrl,
			logo: `${site.baseUrl}/pfp.jpg`,
			sameAs: [
				site.github,
				site.linkedin,
				site.substack,
				site.githubSponsors,
				site.bio
			]
		}
	]}
>
	<div class="flex flex-col gap-16">
		<section
			class="flex flex-col items-start gap-6 sm:flex-row sm:items-center"
		>
			<picture
				class="block size-28 shrink-0 overflow-hidden rounded-2xl ring-2 ring-primary/30 ring-offset-2 ring-offset-base-100"
			>
				<source srcset="/pfp-320.webp" type="image/webp">
				<img
					src="/pfp.jpg"
					alt="Portrait of David Vivar Bogónez"
					width="736"
					height="736"
					decoding="async"
					fetchpriority="high"
					class="h-full w-full object-cover"
				>
			</picture>

			<div class="flex flex-col gap-4">
				<div>
					<p class="eyebrow">Open source developer</p>
					<h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
						David Vivar Bogónez
						<span class="text-base-content/40">/ Aster</span>
					</h1>
					<p class="mt-2 font-mono text-sm text-base-content/60">
						Python · Rust · TypeScript · SQL · Docker/Podman · Java
					</p>
				</div>

				<div class="flex flex-wrap gap-2">
					<a
						href={site.github}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-sm btn-outline gap-2"
					>
						<svg
							class="size-4"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12v3.14c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
							></path>
						</svg>
						GitHub
					</a>
					<a
						href={site.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-sm btn-outline gap-2"
					>
						<svg
							class="size-4"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M6.94 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM3 8.5h3.9V21H3V8.5Zm6.5 0h3.74v1.71h.05c.52-.98 1.8-2.02 3.7-2.02C21.4 8.19 22 10.5 22 13.6V21h-3.9v-6.56c0-1.56-.03-3.57-2.18-3.57-2.18 0-2.51 1.7-2.51 3.46V21H9.5V8.5Z"
							></path>
						</svg>
						LinkedIn
					</a>
					<a
						href={site.bio}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-sm btn-outline gap-2"
					>
						<svg
							class="size-4"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path
								d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
							></path>
							<path
								d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
							></path>
						</svg>
						Linktree
					</a>
					<a href={site.projects} class="btn btn-sm btn-primary gap-2">
						Projects
					</a>
				</div>
			</div>
		</section>

		<section class="max-w-[70ch]">
			<p class="text-base text-base-content/80 leading-relaxed md:text-lg">
				Hi, I am
				<strong class="font-semibold text-base-content"
					>David Vivar Bogónez</strong
				>, a Spanish open source developer most known as
				<strong class="font-semibold text-base-content">Aster</strong>, and a
				computer engineering undergraduate at{" "}
				<a
					href={site.uni}
					target="_blank"
					rel="noopener noreferrer"
					class="link link-hover link-primary"
				>
					ESI-UCLM
				</a
				>. I am passionate about software and computers in general, and I mostly
				work with Python and Rust, along with TypeScript, SQL, Java, and
				containers via Docker and Podman.
			</p>
		</section>

		<section class="flex flex-col gap-5">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<h2 class="text-2xl font-bold tracking-tight">Selected work</h2>
				<a
					href={site.projects}
					class="link link-hover link-primary font-mono text-xs"
				>
					All projects →
				</a>
			</div>
			<p class="max-w-[70ch] text-base-content/70">
				I maintain a handful of open source projects. The most significant ones
				are pinned on my{" "}
				<a
					href={site.githubSponsors}
					target="_blank"
					rel="noopener noreferrer"
					class="link link-hover link-primary"
				>
					GitHub Sponsors profile</a
				>, and the rest live on my{" "}
				<a
					href={site.github}
					target="_blank"
					rel="noopener noreferrer"
					class="link link-hover link-primary"
				>
					GitHub</a
				>.
			</p>
			<ul class="flex flex-wrap gap-2">
				{featured.map((name) => (
					<li>
						<a
							href={`/projects/${name}`}
							class="badge badge-lg badge-ghost font-mono transition-colors hover:border-primary/40 hover:text-primary"
						>
							{name}
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class="flex flex-col gap-6">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<h2 class="text-2xl font-bold tracking-tight">Recent writing</h2>
				<a
					href={site.blog}
					class="link link-hover link-primary font-mono text-xs"
				>
					All posts →
				</a>
			</div>

			<LanguageFilter
				enCount={enPosts.length}
				esCount={esPosts.length}
				initial={initialPosts}
			/>

			<section
				data-post-panel="en"
				class:list={["masonry", initialPosts !== "en" && "hidden"]}
			>
				{enPosts.length > 0 ? (
					enPosts
						.slice(0, recentLimit)
						.map((post) => <PostMeta post={toCard(post)} />)
				) : (
					<p class="text-base-content/60">No English posts yet.</p>
				)}
			</section>

			<section
				data-post-panel="es"
				class:list={["masonry", initialPosts !== "es" && "hidden"]}
			>
				{esPosts.length > 0 ? (
					esPosts
						.slice(0, recentLimit)
						.map((post) => <PostMeta post={toCard(post)} />)
				) : (
					<p class="text-base-content/60">
						Ningún post en Español por ahora...
					</p>
				)}
			</section>

			<p class="max-w-[70ch] text-sm text-base-content/60">
				You can find more posts (some not published here) on my{" "}
				<a
					href={site.substack}
					target="_blank"
					rel="noopener noreferrer"
					class="link link-hover link-primary"
				>
					Substack</a
				>
				publication.
			</p>
		</section>
	</div>
</BaseLayout>
