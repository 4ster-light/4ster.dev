---
interface Props {
	href: string
	target?: string
	rel?: string
	ariaLabel?: string
}

const {
	href,
	target = "_blank",
	rel = "noopener noreferrer",
	ariaLabel
} = Astro.props
---

<!-- biome-ignore lint/a11y/useAnchorContent: Biome fails to detect anchor content since it's inside a slot -->
<a {href} {target} {rel} aria-label={ariaLabel} class="btn btn-secondary gap-2">
	<slot />
</a>
