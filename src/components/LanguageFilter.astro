---
import { blogPath, LANGUAGES, type Lang } from "../lib/site.ts"
import { ui } from "../lib/ui.ts"

interface Props {
	counts: Record<Lang, number>
	current?: Lang
}

const { counts, current } = Astro.props

const LABELS: Record<Lang, string> = { en: "English", es: "Español" }
const filterLabel = ui(current ?? "en").blog.filterLabel
---

<nav class="flex flex-wrap gap-2" aria-label={filterLabel}>
	{LANGUAGES.map((value) => (
		<a
			href={blogPath(value)}
			hreflang={value}
			aria-current={current === value ? "page" : undefined}
			class:list={[
				"btn btn-sm gap-2 font-mono",
				current === value ? "btn-primary" : "btn-ghost"
			]}
		>
			{LABELS[value]}
			<span
				class:list={[
					"badge badge-sm badge-soft",
					value === "en" ? "badge-primary" : "badge-secondary"
				]}
			>
				{counts[value]}
			</span>
		</a>
	))}
</nav>
