---
import "../styles/global.css"
import { ClientRouter } from "astro:transitions"
import NavLink from "../components/NavLink.astro"
import articleIcon from "../icons/Article.svg?raw"
import codeIcon from "../icons/Code.svg?raw"
import loveIcon from "../icons/Love.svg?raw"
import rssIcon from "../icons/Rss.svg?raw"
import { svgMaskUrl } from "../lib/icon.ts"
import site from "../lib/site.ts"

interface Props {
	title?: string
	description?: string
	ogTitle?: string
	ogDescription?: string
	ogType?: "website" | "article"
	ogUrl?: string
	ogImage?: string
	lang?: "en" | "es"
	ogLocale?: string
	canonicalUrl?: string
	alternateUrls?: Array<{ lang: "en" | "es"; href: string }>
	robots?: string
	jsonLd?: Array<Record<string, unknown>>
}

const {
	title = "✰λster✰",
	description = "Personal blog about programming, technology, and computer science.",
	ogTitle = title,
	ogDescription = description,
	ogType = "website",
	ogUrl,
	ogImage = `${site.baseUrl}${site.ogImage}`,
	lang = "en",
	ogLocale = lang === "es" ? "es_ES" : "en_US",
	canonicalUrl,
	alternateUrls,
	robots = "index,follow,max-image-preview:large",
	jsonLd = []
} = Astro.props

const canonical = canonicalUrl ?? new URL(Astro.url.pathname, site.baseUrl).href
const openGraphUrl = ogUrl ?? canonical
const rssMask = svgMaskUrl(rssIcon)

const navLinks = [
	{
		href: site.blog,
		label: "Blog",
		icon: articleIcon,
		target: ""
	},
	{
		href: site.projects,
		label: "Projects",
		icon: codeIcon,
		target: ""
	},
	{
		href: site.donate,
		label: "Support",
		icon: loveIcon,
		target: ""
	}
]
---

<html {lang}>
	<head>
		<ClientRouter />
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta
			name="theme-color"
			content="#0f1419"
			media="(prefers-color-scheme: dark)"
		>
		<meta
			name="theme-color"
			content="#f7fbfb"
			media="(prefers-color-scheme: light)"
		>
		<meta name="color-scheme" content="dark light">
		<meta name="description" content={description}>
		<meta name="robots" content={robots}>
		<meta name="author" content="David Vivar Bogónez">

		<meta property="og:title" content={ogTitle}>
		<meta property="og:type" content={ogType}>
		<meta property="og:description" content={ogDescription}>
		<meta property="og:url" content={openGraphUrl}>
		<meta property="og:site_name" content="✰λster✰">
		<meta property="og:locale" content={ogLocale}>
		<link rel="canonical" href={canonical}>
		{alternateUrls?.map((alternate) => (
			<link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
		))}
		<meta property="og:image" content={ogImage}>

		<meta name="twitter:title" content={ogTitle}>
		<meta name="twitter:description" content={ogDescription}>
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:creator" content="@4ster_light">
		<meta name="twitter:site" content="@4ster_light">
		<meta name="twitter:image" content={ogImage}>
		<meta property="twitter:image:height" content="600">
		<meta property="twitter:image:width" content="1200">

		<title>{title}</title>
		<link rel="icon" href="/pfp.jpg">
		<link
			rel="alternate"
			type="application/rss+xml"
			title="✰λster✰"
			href={`${site.baseUrl}${site.rss}`}
		>
		<link rel="preconnect" href="https://github.com">
		<link rel="preconnect" href="https://avatars.githubusercontent.com">
		<link
			rel="preload"
			href="/fonts/Inter-Regular.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		>
		<link
			rel="preload"
			href="/fonts/Inter-Bold.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		>
		{jsonLd.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}
		<script is:inline>
		;(() => {
			try {
				const stored = localStorage.getItem("theme")
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)"
				).matches
				const theme =
					stored === "teal_light" || stored === "teal_dark"
						? stored
						: prefersDark
							? "teal_dark"
							: "teal_light"
				document.documentElement.setAttribute("data-theme", theme)
			} catch (_error) {
				// Private mode or blocked storage: rely on the media query default.
			}
		})()
		</script>
	</head>
	<body class="min-h-screen flex flex-col bg-base-100 text-base-content">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:btn focus:btn-primary"
		>
			Skip to content
		</a>

		<header
			class="sticky top-0 z-40 border-b border-base-300 bg-base-100/80 backdrop-blur"
		>
			<nav
				class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 sm:px-6 lg:px-0"
			>
				<a
					href={site.url}
					class="text-2xl font-bold tracking-tight text-primary transition-colors hover:text-secondary"
					aria-label="✰λster✰ home"
				>
					✰λster✰
				</a>

				<div class="flex flex-1 items-center justify-end gap-1">
					<div class="flex items-center gap-1">
						{navLinks.map((entry) => <NavLink {...entry} />)}
					</div>

					<a
						href={site.rss}
						class="inline-flex size-9 items-center justify-center rounded-lg text-base-content/70 transition-colors hover:bg-base-200 hover:text-base-content"
						aria-label="Subscribe via RSS"
						title="RSS feed"
					>
						<span
							aria-hidden="true"
							class="inline-block size-[18px] bg-current"
							style={`-webkit-mask-image:${rssMask};mask-image:${rssMask};-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center;-webkit-mask-size:contain;mask-size:contain;`}
						></span>
						<span class="sr-only">RSS</span>
					</a>

					<button
						type="button"
						data-theme-toggle
						class="inline-flex size-9 items-center justify-center rounded-lg text-base-content/70 transition-colors hover:bg-base-200 hover:text-base-content"
						aria-label="Toggle color theme"
					>
						<svg
							class="theme-icon theme-icon-sun size-[18px]"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="4"></circle>
							<path
								d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
							></path>
						</svg>
						<svg
							class="theme-icon theme-icon-moon size-[18px]"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</button>
				</div>
			</nav>
		</header>

		<main
			id="main-content"
			class="mx-auto flex w-full max-w-4xl flex-1 flex-col px-4 py-8 sm:px-6 sm:py-12 lg:px-0"
		>
			<slot />
		</main>

		<footer class="border-t border-base-300 bg-base-200/40">
			<div
				class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-4 px-4 py-8 text-center font-mono text-xs text-base-content/60 sm:flex-row sm:px-6 sm:text-left lg:px-0"
			>
				<p>© {new Date().getFullYear()} ✰λster✰ · David Vivar Bogónez</p>
				<nav class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
					<a href={site.blog} class="link link-hover">Blog</a>
					<a href={site.projects} class="link link-hover">Projects</a>
					<a href={site.rss} class="link link-hover">RSS</a>
					<a href="/license" class="link link-hover">Licensing</a>
				</nav>
			</div>
		</footer>
	</body>
</html>

<script>
const applyStoredTheme = () => {
	try {
		const stored = localStorage.getItem("theme")
		if (stored === "teal_light" || stored === "teal_dark") {
			document.documentElement.setAttribute("data-theme", stored)
		}
	} catch (_error) {
		// Storage unavailable: keep the current theme.
	}
}

const updateThemeToggle = () => {
	const button = document.querySelector("[data-theme-toggle]")
	if (!button) return
	const isDark =
		document.documentElement.getAttribute("data-theme") === "teal_dark"
	const label = isDark ? "Switch to light theme" : "Switch to dark theme"
	button.setAttribute("aria-label", label)
	button.setAttribute("title", label)
}

const toggleTheme = () => {
	const root = document.documentElement
	const isDark = root.getAttribute("data-theme") === "teal_dark"
	const theme = isDark ? "teal_light" : "teal_dark"
	root.setAttribute("data-theme", theme)
	try {
		localStorage.setItem("theme", theme)
	} catch (_error) {
		// Storage unavailable: the preference simply won't persist.
	}
	updateThemeToggle()
}

document.addEventListener("click", (event) => {
	const target = event.target as Element | null
	if (!target?.closest("[data-theme-toggle]")) return
	toggleTheme()
})

// The ClientRouter rebuilds the <html> attributes from each page, so re-apply
// the stored preference right after every swap (and on initial load).
document.addEventListener("astro:after-swap", () => {
	applyStoredTheme()
	updateThemeToggle()
})

document.addEventListener("astro:page-load", () => {
	applyStoredTheme()
	updateThemeToggle()
})

applyStoredTheme()
updateThemeToggle()
</script>
