{
	"name": "4ster.dev",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=12",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		}
	},
	"scripts": {
		"dev": "astro dev",
		"sync": "astro sync",
		"types": "wrangler types",
		"build": "pnpm run sync && astro build && pnpm run types",
		"preview": "pnpm run build && astro preview",
		"fmt": "biome format --write .",
		"lint": "biome check --fix .",
		"check": "pnpm run sync && astro check",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.4.1",
		"@astrojs/markdoc": "2.1.0",
		"@astrojs/react": "7.1.0",
		"@keystatic/astro": "^5.2.0",
		"@keystatic/core": "^0.5.51",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.9",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "7.4.1",
		"daisyui": "^5.7.50",
		"marked": "^15.0.12",
		"marked-gfm-heading-id": "^4.1.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shiki": "^1.29.2",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.11",
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vitest-plugin": "^1.4.7",
		"@playwright/test": "^1.64.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.12",
		"wrangler": "^4.151.2"
	}
}
